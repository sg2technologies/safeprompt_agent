# Rust build output -- this repo's own .cargo/config.toml may still point
# at a different target-dir on some machines; ignore both the local
# default and any override consistently by name.
/target/
target/

# Third-party native runtime DLLs OCR needs (onnxruntime.dll, pdfium.dll) --
# real, multi-MB redistributables, not something this repo vendors in git.
# The build script expects them here and throws a clear, actionable error
# (with the real download source) if they're missing.
/vendor/
vendor/

# Local test/dev artifacts
*.db
*.log
.env
.env.*
!.env.example
.vscode/

# PyInstaller build output for scripts/presidio_scanner.py -- found
# 2026-09-03 already committed (including the ~90MB frozen
# presidio-scanner.exe itself) before this rule existed. build.ps1
# expects the frozen exe to already exist locally (see its own error
# message for the exact freeze command) -- it's a build artifact
# operators produce themselves, never something this repo ships as source.
__pycache__/
*.pyc
scripts/build/
scripts/dist/

# browser-extension/ build/signing artifacts -- key.pem is the CRX-signing
# PRIVATE key (never committed anywhere, verified against full git history
# before this export). A community build should generate its own with
# gen-key.mjs rather than ever expect SG2's production key -- see
# browser-extension/scripts/pack-crx.ps1's own doc comment on this exact
# point. *.crx/update_manifest.xml/dist-unpacked/ are that key's build
# output, same "regenerable, not source" reasoning as target/ above.
browser-extension/key.pem
browser-extension/*.crx
browser-extension/update_manifest.xml
browser-extension/dist-unpacked/
browser-extension/*.zip
# Enterprise-only deployment tooling (GPO/Intune templates for
# Business/Enterprise's CENTRAL Agent mode) -- deliberately excluded from
# this Community export, same boundary as agent-enterprise/ itself.
browser-extension/enterprise/
